<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Comment</key>
	<string>bid-master BAW 周期任务 · 10:00/16:00 标讯抓取（crawl4ai 引擎）（DEV-0052 自 crontab 迁移：macOS TCC 拦截 cron 访问 ~/Documents，launchd 用户代理不受限）</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>
	<key>Label</key>
	<string>com.bidmaster.capture</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/duke/bid-master/rules/cron_baw.sh</string>
		<string>capture</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/duke/.bidmaster/log/launchd-capture.log</string>
	<key>StandardOutPath</key>
	<string>/Users/duke/.bidmaster/log/launchd-capture.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>16</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
</dict>
</plist>
